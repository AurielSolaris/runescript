render: <div id="app"><figure><svg width="100" height="100" viewBox="0 0 100 100"><circle cx="50" cy="50" r="4.5" fill="teal" stroke-linecap="round"></circle><foreignObject x="0" y="0" width="100" height="20"><p>r = 4.5</p></foreignObject></svg><button id="grow" type="button">Grow</button></figure></div>
