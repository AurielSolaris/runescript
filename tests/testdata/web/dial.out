render: <div id="app"><figure><svg width="100" height="100" viewBox="0 0 100 100" role="img" aria-label="A dial"><circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="50" cy="50" r="20" fill="teal"></circle></svg><figcaption>Radius 20</figcaption><button id="smaller" type="button">Smaller</button><button id="bigger" type="button">Bigger</button></figure></div>
